---
import type { Symbol, Category } from "~/types";
import Card from "~/components/Card.astro";

export interface Props {
  category: Category;
  symbols: Symbol[];
}

const { category, symbols } = Astro.props;
const { image, title } = category;
---

<div id={symbols[0].category.id}>
  <div class="pt-16 sticky top-0">
    <a
      class="mb-3 mx-auto flex flex-row items-center px-4 py-2 rounded-full bg-cyan-50 w-fit"
      href={`#${symbols[0].category.id}`}
    >
      <img
        width="48"
        height="48"
        src={image}
        class="mr-2 w-9"
        alt={`${title} symbol`}
      />
      <h1 class="font-medium md:text-lg tracking-wide">{title}</h1>
    </a>
  </div>
  <ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      symbols.map((symbol) => {
        return <Card symbol={symbol} />;
      })
    }
  </ul>
</div>
