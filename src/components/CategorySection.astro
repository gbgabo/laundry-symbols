---
import Card from "~/components/Card.astro";

interface Symbol {
  data: {
    title: string;
    image: string;
    category: string;
    info: {
      legacy: boolean;
    };
  };
}

export interface Props {
  category: {
    title: string;
    icon: string;
  };
  symbols: Symbol[];
}

const { category, symbols } = Astro.props;
const { icon, title } = category;
---

<div id={symbols[0].data.category}>
  <div class="pt-16 sticky top-0">
    <a
      class="mb-3 mx-auto flex flex-row items-center px-4 py-2 rounded-full bg-cyan-50 w-fit"
      href={`#${symbols[0].data.category}`}
    >
      <img
        width="48"
        height="48"
        src={icon}
        class="mr-2 w-9"
        alt={`${title} symbol`}
      />
      <h1 class="font-medium md:text-lg tracking-wide">{title}</h1>
    </a>
  </div>
  <ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {
      symbols.map((symbol) => {
        return <Card symbol={symbol} />;
      })
    }
  </ul>
</div>
