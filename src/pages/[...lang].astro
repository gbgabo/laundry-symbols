---
import Layout from "~/layouts/Layout.astro";
import CategorySection from "~/components/CategorySection.astro";
import SearchBar from "~/components/SearchBar.astro";
import LanguagePicker from "~/components/LanguagePicker.astro";

import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import { fetchSymbols, fetchCategories } from "~/utils/symbols";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

export async function getStaticPaths() {
  const paths = [undefined, "en", "pt-br"];
  return paths.map((lang) => {
    return {
      params: { lang },
    };
  });
}

const { lang = "en" } = Astro.params;
const symbols = fetchSymbols(lang);
const categories = fetchCategories(lang);
---

<Layout title={t("nav.title")} description={t("nav.description")}>
  <Fragment slot="top-bar">
    <div class="grid grid-cols-12 gap-2">
      <div class="col-span-9 md:col-span-10">
        <SearchBar placeholder={t("nav.search")} />
      </div>
      <div class="col-span-3 md:col-span-2">
        <LanguagePicker
          current={lang}
          languages={[
            { slug: "en", emoji: "🇺🇸" },
            { slug: "pt-br", emoji: "🇧🇷" },
          ]}
        />
      </div>
    </div>
  </Fragment>
  <main class="m-auto mb-20 max-w-3xl bg-cyan-50 p-3">
    {
      Object.keys(symbols).map((category) => {
        return (
          <CategorySection
            symbols={symbols[category]}
            category={{ ...categories[category] }}
          />
        );
      })
    }
  </main>
  <Fragment slot="footer" set:html={t("nav.footer")} />
</Layout>
