---
import Layout from "~/layouts/Layout.astro";
import CategorySection from "~/components/CategorySection.astro";
import SearchBar from "~/components/SearchBar.astro";
import LanguagePicker from "~/components/LanguagePicker.astro";

import { languages, type Lang } from "~/i18n/ui";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import { fetchSymbols, fetchCategories } from "~/utils/symbols";

export async function getStaticPaths() {
  const paths: Lang[] = [
    undefined,
    ...(Object.keys(languages) as Array<keyof typeof languages>),
  ];
  return paths.map((lang) => {
    return {
      params: { lang },
      props: {
        symbols: fetchSymbols(lang),
        categories: fetchCategories(lang),
      },
    };
  });
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const { symbols, categories } = Astro.props;
---

<Layout title={t("nav.title")} description={t("nav.description")}>
  <Fragment slot="top-bar">
    <div class="grid grid-cols-12 gap-2">
      <div class="col-span-9 md:col-span-10">
        <SearchBar placeholder={t("nav.search")} />
      </div>
      <div class="col-span-3 md:col-span-2">
        <LanguagePicker current={currentLang} />
      </div>
    </div>
  </Fragment>
  <main class="m-auto mb-20 max-w-3xl bg-cyan-50 p-3">
    {
      Object.keys(symbols).map((category) => {
        return (
          <CategorySection
            symbols={symbols[category]}
            category={{ ...categories[category] }}
          />
        );
      })
    }
  </main>
  <Fragment slot="footer" set:html={t("nav.footer")} />
</Layout>
